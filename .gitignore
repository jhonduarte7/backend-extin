# ==============================================================================
# Equi-Extin Backend .gitignore
# Strictly excludes environment files, secrets, IDEs, and build caches
# ==============================================================================

# --- Environment Variables & Local Secrets ---
.env
.env.*
.env.local
.env.*.local
*.env
!.env.example

# --- Maven Build Artifacts & Dependencies ---
target/
META-INF/
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
classpath.txt
*.jar
*.war
*.class

# --- IDE & Editor Files ---
.idea/
.vscode/
*.iws
*.iml
*.ipr
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# --- Operating System Files ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs, Cookies & Local Developer Tracking ---
*.log
logs/
cookies.txt
[Qq]uestion*
QUESTION*
question/
HELP.md
