# ==============================================================================
# Equi-Extin Backend Environment Variables Template (.env.example)
#
# IMPORTANT:
# - Copy this file to '.env' for local environment customization.
# - NEVER commit real credentials, production secrets, or private keys to Git.
# - Production environments (AWS, Docker, Kubernetes) should inject these via
#   secure secret managers (e.g., AWS Secrets Manager, HashiCorp Vault).
# ==============================================================================

# --- Server Configuration ---
SERVER_PORT=8090

# --- Database Connection (PostgreSQL 16 with pgvector) ---
DB_HOST=localhost
DB_PORT=5433
DB_NAME=fire_safety_db
DB_USER=admin
DB_PASSWORD=your_secure_db_password_here
# Optional: Full JDBC URL (overrides DB_HOST, DB_PORT, DB_NAME if set)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/fire_safety_db

# --- JPA & Hibernate Settings ---
JPA_HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true

# --- Spring Security & JWT Configuration ---
# 256/512-bit hex-encoded secret key for signing HMAC-SHA512 JWT tokens
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Token validity in milliseconds (default: 86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# --- Spring AI & Ollama Configuration ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=all-minilm
AI_INIT_TIMEOUT=120s
AI_CHAT_TIMEOUT=120s
HTTP_CLIENT_CONNECT_TIMEOUT=120s
HTTP_CLIENT_READ_TIMEOUT=180s

# --- Vector Store (pgvector) ---
PGVECTOR_INIT_SCHEMA=true
PGVECTOR_DIMENSIONS=384

# --- Logging Levels ---
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SQL=DEBUG
LOG_LEVEL_BIND=TRACE
